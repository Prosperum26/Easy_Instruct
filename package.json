{
  "name": "easy-instruct",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents teach users step by step with a full-screen spotlight overlay.",
  "keywords": ["mcp", "teaching", "onboarding", "overlay", "vscode", "electron", "claude-code"],
  "author": "Phu Hung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prosperum26/Easy_Instruct.git"
  },
  "homepage": "https://github.com/Prosperum26/Easy_Instruct#readme",
  "bugs": {
    "url": "https://github.com/Prosperum26/Easy_Instruct/issues"
  },
  "type": "module",
  "bin": {
    "easy-instruct": "dist/server/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "overlay:demo": "npm run build && electron dist/overlay/main.cjs",
    "test:helper": "dotnet test native/win-helper",
    "doctor": "node dist/server/index.js doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron": "^44.7.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "files": [
    "dist",
    "skills",
    "config",
    ".claude-plugin",
    ".mcp.json"
  ]
}
