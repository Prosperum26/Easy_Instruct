<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The same sources also run inside Windows PowerShell 5.1 via Add-Type (see host.ps1), which
    compiles with C# 5 against .NET Framework. LangVersion 5 keeps the syntax compatible; stick to
    APIs that exist in both runtimes (no System.Text.Json, ZLibStream, Span, LibraryImport...).
    UseWPF brings System.Windows.Automation (UIA); the Windows 10 TFM brings the WinRT OCR projection.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>win-helper</AssemblyName>
    <RootNamespace>WinHelper</RootNamespace>
    <LangVersion>5</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Selects OcrEngineWinRt.cs; host.ps1 compiles without it and gets OcrEngineReflection.cs. -->
    <DefineConstants>$(DefineConstants);WINRT_PROJECTION</DefineConstants>
  </PropertyGroup>

</Project>
