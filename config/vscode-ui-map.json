{
  "$comment": "How src/locator/vscode-layout.ts recognises VS Code parts in a UI Automation snapshot. Only AutomationIds (DOM ids), CSS classes and codicons are used, never names, which change with the UI language and carry keyboard shortcuts.",
  "editorPart": { "id": "workbench.parts.editor" },
  "statusBar": { "id": "workbench.parts.statusbar" },
  "viewSwitcher": { "type": "Tab", "classes": ["actions-container"] },
  "sidebarSash": { "classes": ["monaco-sash", "primary-sidebar-sash"] },
  "terminal": { "classes": ["terminal", "xterm"] },
  "editorTab": { "type": "TabItem", "classes": ["tab"] },
  "activeClass": "active",
  "checkedClass": "checked",
  "views": {
    "explorer": "codicon-explorer-view-icon",
    "search": "codicon-search-view-icon",
    "run_debug": "codicon-run-view-icon",
    "source_control": "codicon-source-control-view-icon",
    "extensions": "codicon-extensions-view-icon"
  }
}
